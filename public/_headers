# Cloudflare static asset headers (copied to out/_headers by the build).
# scripts/serve-static.mjs applies this file too, so local tests match production.

# Next writes Open Graph images without a file extension.
/opengraph-image
  Content-Type: image/png
/*/opengraph-image
  Content-Type: image/png

# Hashed build assets never change.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Security headers for every response.
# connect-src 'self' is the browser-level guarantee that no image data can be
# sent to another server, even by a compromised script. When analytics is
# turned on, add its host to script-src and connect-src (see DEPLOY.md).
# 'unsafe-inline' scripts are required by Next's static export (inline RSC
# payload, no nonces). blob: workers are how Next starts the image worker.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Frame-Options: DENY
